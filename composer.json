{
    "name": "sgtcoder/laravel-functions",
    "description": "A simple way to add functions to your laravel project.",
    "keywords": [
        "sgtcoder",
        "laravel",
        "laravel-functions"
    ],
    "homepage": "https://github.com/sgtcoder/laravel-functions",
    "license": "MIT",
    "authors": [
        {
            "name": "sgtcoder",
            "email": "usmccoder@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "fakerphp/faker": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "SgtCoder\\LaravelFunctions\\": "src/"
        },
        "files": [
            "src/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SgtCoder\\LaravelFunctions\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Stubs/"
        ]
    },
    "scripts": {
        "test": [
            "vendor/bin/phpstan analyse",
            "vendor/bin/phpunit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SgtCoder\\LaravelFunctions\\LaravelFunctionsServiceProvider",
                "SgtCoder\\LaravelFunctions\\Providers\\CustomServiceProvider",
                "SgtCoder\\LaravelFunctions\\Providers\\StrMacroServiceProvider"
            ],
            "aliases": {
                "LaravelFunctions": "SgtCoder\\LaravelFunctions\\Facades\\LaravelFunctions"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
